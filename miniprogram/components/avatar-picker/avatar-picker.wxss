/** 头像选择组件 **/

.avatar-picker {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 1000;
  visibility: hidden;
  opacity: 0;
  transition: opacity 0.25s ease, visibility 0.25s ease;
}

.avatar-picker.visible {
  visibility: visible;
  opacity: 1;
}

.mask {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
}

.picker-panel {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  background: #fff;
  border-radius: 32rpx 32rpx 0 0;
  padding-bottom: calc(30rpx + env(safe-area-inset-bottom));
  transform: translateY(100%);
  transition: transform 0.3s cubic-bezier(0.32, 0.72, 0, 1);
  max-height: 75vh;
  display: flex;
  flex-direction: column;
}

.avatar-picker.visible .picker-panel {
  transform: translateY(0);
}

/* 顶部标题栏 */
.picker-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 28rpx 30rpx 16rpx;
  border-bottom: 1rpx solid #f1f5f9;
}

.picker-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #0f172a;
}

.close-btn {
  width: 56rpx;
  height: 56rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  background: #f1f5f9;
}

.close-icon {
  font-size: 36rpx;
  color: #64748b;
  line-height: 1;
}

/* 分类 Tab */
.category-bar {
  white-space: nowrap;
  padding: 16rpx 20rpx;
  border-bottom: 1rpx solid #f1f5f9;
}

.category-item {
  display: inline-block;
  padding: 12rpx 24rpx;
  margin-right: 12rpx;
  border-radius: 999rpx;
  background: #f1f5f9;
  transition: all 0.2s ease;
}

.category-item.active {
  background: #1652f0;
}

.category-text {
  font-size: 26rpx;
  color: #64748b;
  font-weight: 500;
}

.category-item.active .category-text {
  color: #fff;
}

/* 头像网格区域 */
.avatar-grid-wrapper {
  flex: 1;
  overflow-y: auto;
  padding: 20rpx;
  -webkit-overflow-scrolling: touch;
}

.grid-loading,
.grid-empty {
  text-align: center;
  padding: 60rpx 0;
  color: #64748b;
  font-size: 28rpx;
}

.avatar-grid {
  display: flex;
  flex-wrap: wrap;
  justify-content: flex-start;
}

.avatar-item {
  width: calc(33.333% - 20rpx);
  margin: 0 10rpx 24rpx;
  position: relative;
  text-align: center;
  box-sizing: border-box;
}

.avatar-image-wrap {
  width: 100%;
  padding-bottom: 100%;
  position: relative;
  border-radius: 20rpx;
  overflow: hidden;
  background: #f1f5f9;
  border: 3rpx solid transparent;
  transition: border-color 0.2s ease;
}

.avatar-item.selected .avatar-image-wrap {
  border-color: #1652f0;
  box-shadow: 0 0 0 4rpx rgba(22, 82, 240, 0.15);
}

.avatar-item.disabled .avatar-image-wrap {
  opacity: 0.5;
}

.avatar-image {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
}

.avatar-placeholder {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #e2e8f0;
  padding: 16rpx;
  box-sizing: border-box;
}

.placeholder-text {
  font-size: 24rpx;
  color: #94a3b8;
  line-height: 1.3;
}

.avatar-name {
  display: block;
  margin-top: 10rpx;
  font-size: 24rpx;
  color: #334155;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.avatar-item.disabled .avatar-name {
  color: #94a3b8;
}

/* 选中角标 */
.selected-badge {
  position: absolute;
  top: 8rpx;
  right: 8rpx;
  width: 36rpx;
  height: 36rpx;
  background: #1652f0;
  border-radius: 50%;
  color: #fff;
  font-size: 22rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-weight: bold;
}
