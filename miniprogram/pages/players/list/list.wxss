.container {
  min-height: 100vh;
  background: #f4f8ff;
  padding: 24rpx;
}

.header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 20rpx;
}

.title {
  font-size: 40rpx;
  color: #0f172a;
  font-weight: 700;
}

.header-right {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.user-avatar {
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  border: 2rpx solid #d9e4fb;
}

.add-btn {
  height: 64rpx;
  line-height: 64rpx;
  border-radius: 32rpx;
  border: none;
  padding: 0 24rpx;
  background: #1652f0;
  color: #fff;
  font-size: 26rpx;
}

.loading,
.empty {
  margin-top: 120rpx;
  text-align: center;
  color: #64748b;
}

.empty-title {
  display: block;
  color: #334155;
  font-size: 30rpx;
  font-weight: 600;
  margin-bottom: 10rpx;
}

.empty-sub {
  font-size: 24rpx;
}

.card {
  position: relative;
  overflow: visible;
  background: #fff;
  border-radius: 16rpx;
  border: 1rpx solid #d9e4fb;
  padding: 24rpx;
  margin-bottom: 16rpx;
  box-shadow: 0 6rpx 16rpx rgba(22, 82, 240, 0.08);
}

.card-mvp {
  border-color: rgba(251, 191, 36, 0.65);
  box-shadow: 0 14rpx 28rpx rgba(245, 158, 11, 0.16);
}

.card-mvp::before {
  content: "";
  position: absolute;
  inset: 0;
  border-radius: 16rpx;
  background: linear-gradient(135deg, rgba(251, 191, 36, 0.12), rgba(255, 255, 255, 0));
  pointer-events: none;
}

.card-main {
  display: flex;
  align-items: center;
  gap: 20rpx;
  margin-bottom: 12rpx;
}

.player-avatar {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  border: 2rpx solid #d9e4fb;
  background: #f8fbff;
  flex-shrink: 0;
}

/* MVP 头像包裹 */
.avatar-wrap {
  position: relative;
  flex-shrink: 0;
  width: 88rpx;
  height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.avatar-wrap .player-avatar {
  border: 2rpx solid #d9e4fb;
  position: relative;
  z-index: 2;
  transition: box-shadow 0.3s ease;
}

.avatar-wrap.mvp .player-avatar {
  border: 4rpx solid #fbbf24;
  box-shadow: 0 8rpx 18rpx rgba(245, 158, 11, 0.22);
}

.avatar-halo {
  position: absolute;
  top: -8rpx;
  left: -8rpx;
  right: -8rpx;
  bottom: -8rpx;
  border-radius: 50%;
  background: radial-gradient(circle, rgba(251, 191, 36, 0.35) 0%, rgba(251, 191, 36, 0.08) 60%, transparent 70%);
  opacity: 0.7;
  animation: mvp-halo 2.5s ease-in-out infinite;
  pointer-events: none;
  z-index: 1;
}

@keyframes mvp-halo {
  0%, 100% {
    opacity: 0.45;
    transform: scale(0.95);
  }
  50% {
    opacity: 0.9;
    transform: scale(1.06);
  }
}

/* 皇冠角标 */
.crown-badge {
  position: absolute;
  top: -8rpx;
  right: -6rpx;
  width: 34rpx;
  height: 34rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #fbbf24, #f59e0b);
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 6rpx 14rpx rgba(245, 158, 11, 0.35);
  z-index: 3;
}

.crown-icon {
  color: #fff;
  font-size: 18rpx;
  line-height: 1;
}

/* 列表 MVP 徽章 */
.name-row {
  display: flex;
  align-items: center;
  gap: 10rpx;
}

.mvp-tag {
  display: inline-block;
  padding: 4rpx 14rpx;
  border-radius: 10rpx;
  background: linear-gradient(135deg, #fbbf24, #f59e0b);
  color: #fff;
  font-size: 20rpx;
  font-weight: 700;
  line-height: 1.3;
  box-shadow: 0 2rpx 8rpx rgba(245, 158, 11, 0.35);
}

.mvp-ribbon {
  position: absolute;
  top: 16rpx;
  right: 20rpx;
  display: flex;
  align-items: center;
  gap: 6rpx;
  padding: 6rpx 14rpx;
  border-radius: 999rpx;
  background: rgba(255, 247, 237, 0.95);
  border: 1rpx solid rgba(245, 158, 11, 0.25);
  z-index: 2;
}

.mvp-ribbon-star {
  color: #f59e0b;
  font-size: 18rpx;
  line-height: 1;
}

.mvp-ribbon-text {
  color: #b45309;
  font-size: 18rpx;
  font-weight: 700;
  line-height: 1;
}

.card-info {
  flex: 1;
  min-width: 0;
}

.nickname {
  font-size: 32rpx;
  color: #0f172a;
  font-weight: 700;
}

.real-name {
  font-size: 24rpx;
  color: #64748b;
}

.meta {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.tag {
  padding: 6rpx 14rpx;
  border-radius: 999rpx;
  background: #eef4ff;
  color: #1652f0;
  font-size: 22rpx;
}

.metrics {
  font-size: 22rpx;
  color: #64748b;
}
