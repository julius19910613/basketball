<view class="container">
  <view class="header">
    <text class="title">球员列表</text>
    <view class="header-right">
      <image class="user-avatar" src="{{userAvatar || '/images/default_avatar.svg'}}" mode="aspectFill" bindtap="goToProfile"></image>
      <button class="add-btn" bindtap="goToCreate">新增球员</button>
    </view>
  </view>

  <view wx:if="{{loading}}" class="loading">加载中...</view>

  <view wx:elif="{{players.length === 0}}" class="empty">
    <text class="empty-title">暂无球员</text>
    <text class="empty-sub">点击右上角“新增球员”开始创建</text>
  </view>

  <view wx:else class="list">
    <view
      class="card {{item.isMvp ? 'card-mvp' : ''}}"
      wx:for="{{players}}"
      wx:key="_id"
      data-id="{{item._id}}"
      bindtap="goToDetail"
    >
      <view wx:if="{{item.isMvp}}" class="mvp-ribbon">
        <text class="mvp-ribbon-star">★</text>
        <text class="mvp-ribbon-text">MVP</text>
      </view>
      <view class="card-main">
        <view class="avatar-wrap {{item.isMvp ? 'mvp' : ''}}">
          <view wx:if="{{item.isMvp}}" class="avatar-halo"></view>
          <image class="player-avatar" src="{{item.avatar || '/images/default_avatar.svg'}}" mode="aspectFill" />
          <view wx:if="{{item.isMvp}}" class="crown-badge">
            <text class="crown-icon">♛</text>
          </view>
        </view>
        <view class="card-info">
          <view class="name-row">
            <text class="nickname">{{item.displayNickname}}</text>
            <text wx:if="{{item.isMvp}}" class="mvp-tag">MVP</text>
          </view>
          <text class="real-name">{{item.displayRealName}}</text>
        </view>
      </view>
      <view class="meta">
        <text class="tag">{{item.displayPosition}}</text>
        <text class="metrics">{{item.height || '-'}}cm / {{item.weight || '-'}}kg / {{item.age || '-'}}岁</text>
      </view>
    </view>
  </view>
</view>
