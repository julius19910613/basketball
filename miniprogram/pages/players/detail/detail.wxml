<view class="container">
  <view wx:if="{{loading}}" class="loading">加载中...</view>

  <view wx:elif="{{errorMessage}}" class="error-wrap">
    <text class="error">{{errorMessage}}</text>
  </view>

  <view wx:elif="{{player}}" class="card {{editing ? 'editing' : ''}}">
    <!-- 查看模式 -->
    <block wx:if="{{!editing}}">
      <view class="head">
        <view class="detail-avatar-wrap {{player.isMvp ? 'mvp' : ''}}">
          <image class="player-avatar" src="{{player.avatar || '/images/default_avatar.svg'}}" mode="aspectFill" />
        </view>
        <view class="head-info">
          <view class="nickname-row">
            <text class="nickname">{{player.nickname}}</text>
            <text wx:if="{{player.isMvp}}" class="mvp-badge">MVP</text>
          </view>
          <text class="position">{{player.position}}</text>
        </view>
      </view>

      <view class="row">
        <text class="label">真实姓名</text>
        <text class="value">{{player.realName}}</text>
      </view>
      <view class="row" wx:if="{{player.birthdayText && player.birthdayText !== '-'}}">
        <text class="label">生日</text>
        <text class="value">{{player.birthdayText}}</text>
      </view>
      <view class="row">
        <text class="label">年龄</text>
        <text class="value">{{player.age}} 岁</text>
      </view>
      <view class="row">
        <text class="label">身高</text>
        <text class="value">{{player.height}} cm</text>
      </view>
      <view class="row">
        <text class="label">体重</text>
        <text class="value">{{player.weight}} kg</text>
      </view>
      <view class="row">
        <text class="label">创建时间</text>
        <text class="value">{{player.createdAtText}}</text>
      </view>
    </block>

    <!-- 编辑模式 -->
    <block wx:else>
      <!-- 头像选择 -->
      <view class="form-item edit-avatar-item">
        <text class="label">头像</text>
        <view class="edit-avatar-row" bindtap="onChooseAvatar">
          <image class="edit-avatar-preview" src="{{editForm.avatar || '/images/default_avatar.svg'}}" mode="aspectFill" />
          <text class="edit-avatar-hint">点击更换</text>
        </view>
      </view>

      <view class="form-item">
        <text class="label">昵称</text>
        <input class="edit-input" placeholder="请输入昵称" value="{{editForm.nickname}}" data-field="nickname" bindinput="onEditInput" maxlength="20" />
      </view>

      <view class="form-item">
        <text class="label">真实姓名</text>
        <input class="edit-input" placeholder="请输入真实姓名" value="{{editForm.realName}}" data-field="realName" bindinput="onEditInput" maxlength="30" />
      </view>

      <view class="form-item">
        <text class="label">场上位置</text>
        <picker mode="selector" range="{{positionDisplayNames}}" value="{{editForm.positionIndex}}" bindchange="onEditPositionChange">
          <view class="picker-value">{{positionDisplayNames[editForm.positionIndex]}}</view>
        </picker>
      </view>

      <view class="form-item">
        <text class="label">生日</text>
        <picker mode="date" value="{{editForm.birthday}}" bindchange="onEditBirthdayChange">
          <view class="picker-value {{!editForm.birthday ? 'placeholder' : ''}}">
            {{editForm.birthday || '请选择生日'}}
          </view>
        </picker>
      </view>

      <view class="form-item">
        <text class="label">身高(cm)</text>
        <input class="edit-input" type="digit" placeholder="120-250" value="{{editForm.height}}" data-field="height" bindinput="onEditInput" />
      </view>

      <view class="form-item">
        <text class="label">体重(kg)</text>
        <input class="edit-input" type="digit" placeholder="30-200" value="{{editForm.weight}}" data-field="weight" bindinput="onEditInput" />
      </view>

      <!-- MVP 开关 -->
      <view class="form-item mvp-edit-item">
        <text class="label">⭐ MVP 球员</text>
        <switch color="#f59e0b" checked="{{editForm.isMvp}}" bindchange="onToggleMvpEdit" />
      </view>
    </block>
  </view>

  <view wx:if="{{player}}" class="match-card" bindtap="goMatchRecords">
    <view class="match-head">
      <text class="match-title">📊 比赛记录</text>
      <text class="match-link">查看详情 ></text>
    </view>
    <view wx:if="{{matchStats && matchStats.games > 0}}">
      <text class="match-text">总场次：{{matchStats.games}} 场 · 场均：{{matchStats.avgPoints}} 分 / {{matchStats.avgRebounds}} 板 / {{matchStats.avgAssists}} 助</text>
      <text class="match-text">最高分：{{matchStats.maxPoints}} · 命中率：{{matchStats.fgPct}}%</text>
    </view>
    <text wx:else class="match-empty">暂无比赛数据，点击查看比赛列表</text>
  </view>

  <view wx:if="{{player}}" class="rating-card">
    <view class="match-head">
      <text class="match-title">球员评分</text>
      <text class="rating-score">{{ratingSummary && ratingSummary.ratingCount ? ratingSummary.averageScore + '分' : '暂无'}}</text>
    </view>
    <view wx:if="{{ratingSummary && ratingSummary.ratingCount > 0}}">
      <text class="match-text">累计 {{ratingSummary.ratingCount}} 次评分 · 平均 {{ratingSummary.averageStar}} 星</text>
      <view class="rating-tags" wx:if="{{ratingSummary.tagSummary && ratingSummary.tagSummary.length}}">
        <text wx:for="{{ratingSummary.tagSummary}}" wx:key="tag" class="rating-tag">{{item.tag}} {{item.count}}</text>
      </view>
    </view>
    <text wx:else class="match-empty">暂无评分数据</text>
  </view>

  <!-- 底部操作栏 -->
  <view wx:if="{{player}}" class="action-bar">
    <block wx:if="{{!editing}}">
      <button class="btn btn-primary" bindtap="onEdit">编辑球员</button>
    </block>
    <block wx:else>
      <button class="btn btn-outline" bindtap="onCancel">取消</button>
      <button class="btn btn-primary" loading="{{saving}}" disabled="{{saving}}" bindtap="onSave">保存修改</button>
    </block>
  </view>

  <!-- 头像选择器 -->
  <avatar-picker
    visible="{{avatarPickerVisible}}"
    selectedId="{{selectedAvatarId}}"
    bind:select="onAvatarSelected"
    bind:close="onAvatarPickerClose"
  />
</view>
