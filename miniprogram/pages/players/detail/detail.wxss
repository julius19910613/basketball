.container {
  min-height: 100vh;
  background: #f4f8ff;
  padding: 24rpx;
  padding-bottom: 200rpx;
}

.loading,
.error-wrap {
  margin-top: 160rpx;
  text-align: center;
  color: #64748b;
}

.error {
  color: #dc2626;
}

.card {
  background: #fff;
  border-radius: 16rpx;
  border: 1rpx solid #d9e4fb;
  padding: 28rpx;
  box-shadow: 0 6rpx 16rpx rgba(22, 82, 240, 0.08);
}

.card.editing {
  border-color: #1652f0;
}

.head {
  margin-bottom: 24rpx;
  padding-bottom: 16rpx;
  border-bottom: 1rpx solid #e2e8f0;
  display: flex;
  align-items: center;
  gap: 24rpx;
}

.player-avatar {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  border: 2rpx solid #d9e4fb;
  background: #f8fbff;
  flex-shrink: 0;
}

/* 详情页 MVP 头像包裹 */
.detail-avatar-wrap {
  position: relative;
  flex-shrink: 0;
}

.detail-avatar-wrap .player-avatar {
  border: 2rpx solid #d9e4fb;
}

.detail-avatar-wrap.mvp .player-avatar {
  border: 4rpx solid #fbbf24;
}

/* MVP 光晕效果 - 独立层动画，避免box-shadow重绘 */
.detail-avatar-wrap.mvp::after {
  content: "";
  position: absolute;
  top: -8rpx;
  left: -8rpx;
  right: -8rpx;
  bottom: -8rpx;
  border-radius: 50%;
  background: radial-gradient(circle, rgba(251, 191, 36, 0.35) 0%, rgba(251, 191, 36, 0.08) 60%, transparent 70%);
  opacity: 0.6;
  animation: mvp-halo 2.5s ease-in-out infinite;
  pointer-events: none;
  z-index: -1;
}

@keyframes mvp-halo {
  0%, 100% {
    opacity: 0.4;
    transform: scale(0.95);
  }
  50% {
    opacity: 0.85;
    transform: scale(1.05);
  }
}

/* 显示模式 昵称 + MVP 徽章 */
.nickname-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 8rpx;
}

.nickname-row .nickname {
  margin-bottom: 0;
}

.mvp-badge {
  display: inline-block;
  padding: 4rpx 14rpx;
  border-radius: 10rpx;
  background: linear-gradient(135deg, #fbbf24, #f59e0b);
  color: #fff;
  font-size: 20rpx;
  font-weight: 700;
  line-height: 1.3;
  box-shadow: 0 2rpx 8rpx rgba(245, 158, 11, 0.35);
}

/* 编辑模式 MVP 开关行 */
.mvp-edit-item {
  justify-content: space-between;
}

.mvp-edit-item .label {
  color: #b45309;
  font-weight: 600;
}

.head-info {
  flex: 1;
  min-width: 0;
}

.nickname {
  display: block;
  font-size: 38rpx;
  color: #0f172a;
  font-weight: 700;
  margin-bottom: 8rpx;
}

.position {
  display: inline-block;
  padding: 6rpx 14rpx;
  border-radius: 999rpx;
  background: #eef4ff;
  color: #1652f0;
  font-size: 22rpx;
}

.row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 16rpx 0;
  border-bottom: 1rpx solid #f1f5f9;
}

.row:last-child {
  border-bottom: none;
}

.label {
  color: #64748b;
  font-size: 24rpx;
}

.value {
  color: #0f172a;
  font-size: 26rpx;
  font-weight: 600;
}

/* 编辑模式样式 */
.form-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 16rpx 0;
  border-bottom: 1rpx solid #f1f5f9;
}

.form-item:last-child {
  border-bottom: none;
}

.edit-input {
  flex: 1;
  text-align: right;
  font-size: 26rpx;
  color: #1652f0;
  font-weight: 600;
  margin-left: 20rpx;
}

.picker-value {
  font-size: 26rpx;
  color: #1652f0;
  font-weight: 600;
}

.picker-value.placeholder {
  color: #cbd5e1;
  font-weight: normal;
}

/* 编辑模式头像 */
.edit-avatar-item {
  align-items: flex-start;
}

.edit-avatar-row {
  display: flex;
  align-items: center;
  gap: 20rpx;
}

.edit-avatar-preview {
  width: 100rpx;
  height: 100rpx;
  border-radius: 50%;
  border: 2rpx solid #d9e4fb;
  background: #f8fbff;
}

.edit-avatar-hint {
  font-size: 26rpx;
  color: #1652f0;
}

/* 底部操作栏 */
.action-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  padding: 30rpx 40rpx calc(30rpx + env(safe-area-inset-bottom));
  background: rgba(255, 255, 255, 0.95);
  display: flex;
  gap: 20rpx;
  box-shadow: 0 -4rpx 20rpx rgba(0, 0, 0, 0.05);
}

.btn {
  flex: 1;
  height: 88rpx;
  line-height: 88rpx;
  font-size: 30rpx;
  font-weight: 600;
  border-radius: 44rpx;
  border: none;
  padding: 0;
  margin: 0;
}

.btn-primary {
  background: #1652f0;
  color: #fff;
}

.btn-outline {
  background: #fff;
  color: #64748b;
  border: 1rpx solid #e2e8f0;
}

.btn::after {
  border: none;
}

.match-card {
  margin-top: 20rpx;
  background: #fff;
  border-radius: 16rpx;
  border: 1rpx solid #d9e4fb;
  box-shadow: 0 6rpx 16rpx rgba(22, 82, 240, 0.08);
  padding: 24rpx;
}

.rating-card {
  margin-top: 20rpx;
  background: #fff;
  border-radius: 16rpx;
  border: 1rpx solid #d9e4fb;
  box-shadow: 0 6rpx 16rpx rgba(22, 82, 240, 0.08);
  padding: 24rpx;
}

.rating-score {
  color: #1652f0;
  font-size: 26rpx;
  font-weight: 700;
}

.rating-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
  margin-top: 14rpx;
}

.rating-tag {
  padding: 6rpx 12rpx;
  border-radius: 8rpx;
  background: #eef4ff;
  color: #1652f0;
  font-size: 22rpx;
}

.match-head {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 10rpx;
}

.match-title {
  color: #0f172a;
  font-size: 30rpx;
  font-weight: 700;
}

.match-link {
  color: #1652f0;
  font-size: 22rpx;
}

.match-text,
.match-empty {
  display: block;
  color: #64748b;
  font-size: 24rpx;
  line-height: 1.6;
}
