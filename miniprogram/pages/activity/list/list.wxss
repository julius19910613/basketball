.container {
  min-height: 100vh;
  background: #f4f8ff;
  padding: 24rpx;
}

.header,
.row {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.title {
  color: #0f172a;
  font-size: 40rpx;
  font-weight: 700;
}

.create-btn {
  height: 64rpx;
  line-height: 64rpx;
  border-radius: 32rpx;
  border: none;
  margin: 0;
  padding: 0 24rpx;
  background: #1652f0;
  color: #fff;
  font-size: 24rpx;
}

.create-btn::after {
  border: none;
}

.status {
  margin-top: 160rpx;
  text-align: center;
  color: #64748b;
}

.card {
  background: #fff;
  border-radius: 18rpx;
  border: 1rpx solid #d9e4fb;
  box-shadow: 0 8rpx 20rpx rgba(22, 82, 240, 0.08);
  padding: 24rpx;
  margin-top: 18rpx;
}

.name {
  color: #0f172a;
  font-size: 30rpx;
  font-weight: 700;
}

.tag {
  background: #eef4ff;
  color: #1652f0;
  border-radius: 999rpx;
  padding: 8rpx 18rpx;
  font-size: 20rpx;
}

.meta {
  display: block;
  margin-top: 10rpx;
  color: #64748b;
  font-size: 24rpx;
}
